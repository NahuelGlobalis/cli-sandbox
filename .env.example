# Generá una auth key en https://login.tailscale.com/admin/settings/keys
# y guardala en un archivo .env local (ese archivo está ignorado por Git).
TS_AUTHKEY=

# Nombre estable que aparecerá en MagicDNS y en la lista de dispositivos.
TAILSCALE_HOSTNAME=clis-code

# Opcional: nombre o IP de un exit node del tailnet para que todo el trafico
# del nodo salga por ahi. Dejalo vacio para salida directa.
TAILSCALE_EXIT_NODE=

# Anunciar este nodo como exit node (requiere aprobacion en Tailscale Admin).
# No combinar true con TAILSCALE_EXIT_NODE. Ambos desactivados: nodo normal.
TAILSCALE_ADVERTISE_EXIT_NODE=false

# Permitir acceso directo a la LAN mientras se utiliza otro exit node.
# Mantener false si TAILSCALE_EXIT_NODE esta vacio.
TAILSCALE_EXIT_NODE_ALLOW_LAN_ACCESS=false

# Raíz de WSL que contiene todos los repositorios de trabajo.
CLIS_PROJECTS_ROOT=/mnt/c/dev
