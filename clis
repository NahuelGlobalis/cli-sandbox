#!/usr/bin/env bash
set -euo pipefail

IMAGE="clis-code:latest"
HOST_SKILLS_DIR="$HOME/.agents/skills"
HOST_HOME_DIR="$HOME/.clis-code/home"
CONTAINER_PROJECTS_DIR="/home/dev/projects"

mkdir -p "$HOST_SKILLS_DIR" "$HOST_HOME_DIR"

# --- Localizar la configuración del repositorio, incluso desde un symlink ---
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
CLIS_REPO_DIR="${CLIS_REPO_DIR:-$SCRIPT_DIR}"
COMPOSE_FILE="${CLIS_COMPOSE_FILE:-$CLIS_REPO_DIR/docker-compose.yml}"
ENV_FILE="${CLIS_ENV_FILE:-$CLIS_REPO_DIR/.env}"

# Compose resuelve bind mounts en el host Docker. Desde una sesion clis, HOME y
# SSH_AUTH_SOCK son rutas del contenedor y recrearian el servicio con mounts
# incorrectos, incluido el home que contiene authorized_keys de Moshi.
if [[ -f /.dockerenv ]]; then
    echo "Error: ejecutá clis desde el host WSL, no desde dentro del contenedor." >&2
    echo "Esto protege los mounts persistentes de credenciales, SSH y Moshi." >&2
    exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
    echo "Error: Docker Compose v2 no está instalado." >&2
    echo "Instalalo en Ubuntu/WSL con:  sudo apt install docker-compose-v2" >&2
    exit 1
fi

if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "Error: no se encontró $COMPOSE_FILE" >&2
    echo "Si copiaste este script, definí CLIS_REPO_DIR con la ruta del repositorio clis-code." >&2
    exit 1
fi

if [[ ! -f "$ENV_FILE" ]]; then
    echo "Error: no se encontró $ENV_FILE" >&2
    echo "Crealo desde .env.example y configurá TS_AUTHKEY." >&2
    exit 1
fi

# --- Cargar variables del .env en este shell (Compose ya lo recibe vía --env-file) ---
# Solo KEY=VALUE simples; ignoramos líneas vacías y comentarios.
set +e
while IFS='=' read -r _key _value; do
    [[ -z "$_key" || "$_key" =~ ^[[:space:]]*# ]] && continue
    # Quitar espacios alrededor de la clave y eventuales comillas del valor.
    _key="${_key//[[:space:]]/}"
    case "$_value" in
        \"*\"|\'*\') _value="${_value:1:${#_value}-2}" ;;
    esac
    export "$_key=$_value"
done < "$ENV_FILE"
set -e

HOST_PROJECTS_ROOT="${CLIS_PROJECTS_ROOT:-/mnt/c/dev}"

if [[ ! -d "$HOST_PROJECTS_ROOT" ]]; then
    echo "Error: la raíz de proyectos no existe: $HOST_PROJECTS_ROOT" >&2
    echo "Definí CLIS_PROJECTS_ROOT con el directorio que contiene tus repos." >&2
    exit 1
fi

HOST_PROJECTS_ROOT="$(cd "$HOST_PROJECTS_ROOT" && pwd -P)"
export CLIS_PROJECTS_ROOT="$HOST_PROJECTS_ROOT"

# --- Ejecutar Compose desde el repositorio aunque clis se invoque desde otro cwd ---
COMPOSE_ARGS=(
    compose
    --file "$COMPOSE_FILE"
    --env-file "$ENV_FILE"
    --project-directory "$CLIS_REPO_DIR"
)

UP_ONLY=0
case "${1:-}" in
    down)
        [[ $# -eq 1 ]] || { echo "Error: clis down no acepta argumentos." >&2; exit 2; }
        mapfile -t SESSION_CONTAINERS < <(
            docker ps -aq --filter 'name=clis-code-run-'
        )
        if [[ ${#SESSION_CONTAINERS[@]} -gt 0 ]]; then
            docker rm -f "${SESSION_CONTAINERS[@]}" >/dev/null
        fi
        docker "${COMPOSE_ARGS[@]}" down
        echo "clis-code detenido; los volúmenes y la identidad de Tailscale se conservaron."
        exit 0
        ;;
    up)
        [[ $# -eq 1 ]] || { echo "Error: clis up no acepta argumentos." >&2; exit 2; }
        UP_ONLY=1
        shift
        ;;
esac

# --- Verificar que la imagen existe ---
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Error: la imagen '$IMAGE' no existe." >&2
    echo "Creala con:  docker compose --file $COMPOSE_FILE --env-file $ENV_FILE build clis-code" >&2
    exit 1
fi

if [[ "$UP_ONLY" == "0" ]]; then
    # --- Conservar la ubicación dentro de la raíz de proyectos compartida ---
    HOST_CWD="$(pwd -P)"
    case "$HOST_CWD" in
        "$HOST_PROJECTS_ROOT")
            RELATIVE_CWD=""
            ;;
        "$HOST_PROJECTS_ROOT"/*)
            RELATIVE_CWD="${HOST_CWD#"$HOST_PROJECTS_ROOT"}"
            ;;
        *)
            echo "Error: el directorio actual está fuera de $HOST_PROJECTS_ROOT" >&2
            echo "Entrá a un repo bajo esa raíz o definí CLIS_PROJECTS_ROOT." >&2
            exit 1
            ;;
    esac
    CONTAINER_WD="$CONTAINER_PROJECTS_DIR$RELATIVE_CWD"

    RUN_ARGS=(
        run --rm --init -i
        --name "clis-code-run-$$"
        --volumes-from clis-code
        --network container:clis-tailscale
        -e CLIS_REMOTE_SERVICES=0
        -v "$HOST_SKILLS_DIR":/home/dev/.gemini/antigravity-cli/skills
        -w "$CONTAINER_WD"
    )

    if [[ -t 0 && -t 1 ]]; then
        RUN_ARGS+=(-t)
    fi

    # --- SSH agent forwarding (si el agent está activo en el host) ---
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
        RUN_ARGS+=(
            -v "${SSH_AUTH_SOCK}":/tmp/ssh-agent.sock:ro
            -e SSH_AUTH_SOCK=/tmp/ssh-agent.sock
        )
    fi

    # --- Parsear flags del script ---
    CMD_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --port|-p)
                [[ $# -ge 2 ]] || { echo "Error: $1 requiere un valor." >&2; exit 2; }
                echo "Error: --port no es compatible con la red compartida de Tailscale." >&2
                echo "Escuchá en 0.0.0.0 y accedé a clis-code:<puerto> desde el tailnet." >&2
                exit 2
                ;;
            --env|-e)
                [[ $# -ge 2 ]] || { echo "Error: $1 requiere un valor." >&2; exit 2; }
                RUN_ARGS+=("-e" "$2")
                shift 2
                ;;
            *)
                CMD_ARGS+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#CMD_ARGS[@]} -eq 0 ]]; then
        CMD_ARGS=(/bin/bash)
    fi
fi

# Compose considera al sidecar una dependencia, pero hacemos el arranque aquí
# para poder informar claramente si el tailnet exige aprobar el dispositivo.
docker "${COMPOSE_ARGS[@]}" up -d tailscale >/dev/null
TAILSCALE_STATE=""
for _ in {1..30}; do
    TAILSCALE_STATE="$(
        docker "${COMPOSE_ARGS[@]}" exec -T tailscale tailscale status --json 2>/dev/null \
            | sed -n 's/.*"BackendState":[[:space:]]*"\([^"]*\)".*/\1/p'
    )"
    case "$TAILSCALE_STATE" in
        Running)
            break
            ;;
        NeedsMachineAuth)
            echo "Error: el nodo clis-code espera aprobación en Tailscale Admin > Machines." >&2
            echo "Aprobalo en https://login.tailscale.com/admin y volvé a ejecutar clis." >&2
            exit 1
            ;;
    esac
    sleep 1
done

if [[ "$TAILSCALE_STATE" != "Running" ]]; then
    echo "Error: Tailscale no alcanzó el estado Running (estado: ${TAILSCALE_STATE:-desconocido})." >&2
    echo "Revisá: docker compose --file $COMPOSE_FILE logs tailscale" >&2
    exit 1
fi

# --- Preservar SSH agent forwarding en `clis up` ---
# Si SSH_AUTH_SOCK no apunta a un socket, Compose interpolaría /dev/null
# y recrearía clis-code con forwarding roto. Reutilizar el mount existente
# del servicio persistente evita pisar un forwarding que ya funciona.
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
    export SSH_AUTH_SOCK
else
    EXISTING_SOCK="$(docker inspect clis-code --format '{{range .Mounts}}{{if eq .Destination "/run/host-services/ssh-auth.sock"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || true)"
    if [[ -n "${EXISTING_SOCK:-}" && "${EXISTING_SOCK}" != "/dev/null" && -S "${EXISTING_SOCK}" ]]; then
        export SSH_AUTH_SOCK="${EXISTING_SOCK}"
        echo "WARN: SSH_AUTH_SOCK no está activo; preservando forwarding con ${EXISTING_SOCK}" >&2
        echo "      Iniciá el agent (eval \$(ssh-agent) && ssh-add) y re-ejecutá clis up para actualizar." >&2
    elif [[ -n "${EXISTING_SOCK:-}" && "${EXISTING_SOCK}" != "/dev/null" ]]; then
        export SSH_AUTH_SOCK="${EXISTING_SOCK}"
        echo "WARN: SSH_AUTH_SOCK apunta a ${EXISTING_SOCK} pero el socket no existe (stale tras reiniciar WSL/agent)." >&2
        echo "      Iniciá el agent y re-ejecutá clis up." >&2
    else
        echo "WARN: SSH_AUTH_SOCK no está definido o no es un socket; Git por SSH fallará hasta que inicies el agent." >&2
        echo "      Ejecutá: eval \$(ssh-agent) && ssh-add && clis up" >&2
    fi
fi

# --- Asegurar el servicio persistente que recibe Moshi/SSH ---
# `clis` abre sesiones efímeras con CLIS_REMOTE_SERVICES=0, pero Moshi se
# conecta al servicio persistente `clis-code` (sleep infinity + sshd +
# moshi-hook). Lo arrancamos aquí para que el teléfono siempre tenga a quién
# conectarse, incluso cuando solo se invoca clis. `up -d` es idempotente.
docker "${COMPOSE_ARGS[@]}" up -d clis-code >/dev/null
PERSISTENT_READY=""
for _ in {1..30}; do
    if docker exec clis-code pgrep -x sshd >/dev/null 2>&1; then
        PERSISTENT_READY=1
        break
    fi
    sleep 1
done
if [[ -z "$PERSISTENT_READY" ]]; then
    echo "WARN: el servicio persistente clis-code no arrancó sshd a tiempo." >&2
    echo "Moshi podría no conectar. Revisá: docker compose --file $COMPOSE_FILE logs clis-code" >&2
fi

# Si tailscale fue reiniciado, los contenedores que compartían su namespace
# pueden conservar una red obsoleta aunque sshd siga activo. Recrear solo el
# servicio persistente vuelve a adjuntarlo sin tocar identidad ni volúmenes.
TAILSCALE_IP="$(docker exec clis-code tailscale ip -4 2>/dev/null || true)"
if [[ -n "$PERSISTENT_READY" && -n "$TAILSCALE_IP" ]] \
    && ! docker exec clis-code timeout 2 bash -c \
        'exec 3<>"/dev/tcp/$1/22"' _ "$TAILSCALE_IP" 2>/dev/null; then
    echo "WARN: SSH no responde en la IP Tailscale; recreando clis-code." >&2
    docker "${COMPOSE_ARGS[@]}" up -d --force-recreate clis-code >/dev/null
    PERSISTENT_READY=""
    for _ in {1..30}; do
        TAILSCALE_IP="$(docker exec clis-code tailscale ip -4 2>/dev/null || true)"
        if [[ -n "$TAILSCALE_IP" ]] && docker exec clis-code timeout 2 bash -c \
            'exec 3<>"/dev/tcp/$1/22"' _ "$TAILSCALE_IP" 2>/dev/null; then
            PERSISTENT_READY=1
            break
        fi
        sleep 1
    done
    if [[ -z "$PERSISTENT_READY" ]]; then
        echo "WARN: SSH sigue sin responder en la IP Tailscale." >&2
    fi
fi

if [[ "$UP_ONLY" == "1" ]]; then
    echo "clis-code iniciado; Tailscale y SSH están listos."
    exit 0
fi

# Compose 2.7 no puede crear un one-off con `network_mode: service:tailscale`
# sobre Docker 27. Reutilizar los mounts del servicio persistente evita
# duplicar la configuración y adjunta la sesión al mismo namespace de red.
docker "${RUN_ARGS[@]}" "$IMAGE" "${CMD_ARGS[@]}"
