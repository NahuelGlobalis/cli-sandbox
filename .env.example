# Generá una auth key en https://login.tailscale.com/admin/settings/keys
# y guardala en un archivo .env local (ese archivo está ignorado por Git).
TS_AUTHKEY=

# Nombre estable que aparecerá en MagicDNS y en la lista de dispositivos.
TAILSCALE_HOSTNAME=clis-code

# Raíz de WSL que contiene todos los repositorios de trabajo.
CLIS_PROJECTS_ROOT=/mnt/c/dev
